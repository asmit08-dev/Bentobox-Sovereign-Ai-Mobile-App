{
  "expo": {
    "name": "Bentobox AI",
    "slug": "bentobox-sovereign-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bentobox",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ai.zolix.bentobox"
    },
    "android": {
      "package": "ai.zolix.bentobox",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFEEF3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Bentobox to use the microphone so you can talk to it."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bentobox to open your photos so you can ask about them.",
          "cameraPermission": "Allow Bentobox to use the camera so you can ask about a photo."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
